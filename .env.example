# ---------------------------------------------------------------
# Copie para .env (desenvolvimento) e preencha. NUNCA versione o .env.
# Na Vercel, cadastre estas variáveis em Project Settings → Environment Variables.
# Nenhuma delas usa o prefixo NEXT_PUBLIC_: todas ficam apenas no servidor.
# ---------------------------------------------------------------

# Conexão PostgreSQL.
# Produção (Neon): copie a "connection string" do painel do Neon (com ?sslmode=require).
#   ex.: postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Desenvolvimento local:
DATABASE_URL=postgresql://lecurso:lecurso@localhost:5432/lecurso_dev

# Segredo usado para assinar sessões. Gere um valor aleatório com:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-valor-aleatorio-de-32-bytes

# URL pública do site (sem barra no final). Em produção: https://seudominio.com.br
SITE_URL=http://localhost:3000

# (Opcional) Domínios permitidos para links de compra, separados por vírgula.
# Subdomínios são aceitos automaticamente (ex.: pay.hotmart.com).
# PURCHASE_ALLOWED_HOSTS=hotmart.com,kiwify.com.br,kiwify.app,mercadopago.com.br,mpago.la,eduzz.com,wa.me,api.whatsapp.com

# (Opcional) Hosts de imagens otimizadas pelo Next.js. "*.dominio" aceita subdomínios.
# Imagens de outros hosts https funcionam, porém sem otimização.
# IMAGE_OPTIMIZED_HOSTS=res.cloudinary.com,*.public.blob.vercel-storage.com
